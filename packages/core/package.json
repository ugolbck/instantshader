{
  "name": "instantshader",
  "version": "0.0.0",
  "description": "Animated WebGL gradient shaders. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instantgradient/instantshader.git",
