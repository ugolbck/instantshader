{
  "name": "instantshader",
  "version": "0.7.0",
  "description": "Animated WebGL gradient shaders, plus dither, pixelate, halftone and ASCII effects. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugolbck/instantshader.git",
    "directory": "packages/core"
  },
  "homepage": "https://instantgradient.com/app",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webgl",
    "shader",
    "gradient",
    "mesh-gradient",
    "animated-gradient",
    "background",
    "dither",
    "halftone",
    "pixelate",
    "ascii"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint:pkg": "publint && attw --pack . --profile esm-only"
  }
}
